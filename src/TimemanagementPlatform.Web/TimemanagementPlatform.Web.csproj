  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimemanagementPlatform.Application\TimemanagementPlatform.Application.csproj" />
    <ProjectReference Include="..\TimemanagementPlatform.Domain\TimemanagementPlatform.Domain.csproj" />
    <ProjectReference Include="..\TimemanagementPlatform.Infrastructure\TimemanagementPlatform.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Data\**\*.cs" />
    <Compile Remove="Models\ApplicationUser.cs" />
    <Compile Remove="Models\Semester.cs" />
    <Compile Remove="Models\Module.cs" />
    <Compile Remove="Models\ModuleHour.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\Background2.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\Background.jpg">
