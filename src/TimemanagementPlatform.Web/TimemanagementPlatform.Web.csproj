<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-TimemanagementPlatform.Web</UserSecretsId>
    <RootNamespace>TimemanagementPlatform.Web</RootNamespace>
    <AssemblyName>TimemanagementPlatform.Web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Areas\Identity\Pages\Account\Manage\Background.jpg" />
