<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TimeManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TimemanagementPlatform.Web.styles.css" asp-append-version="true" />
    <style>
        body {
            background-image: url("Background.jpg");            
            background-repeat: no-repeat;
            background-size: cover;
            background-color: transparent;
        }

        .bg-panel {
            background-color: #0083c9 !important;
        }

        .navtext {
            font-size: 20px;
        }

        .navtitle {
            font-size: 28px;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-panel">
            <div class="container-fluid">
                <a class="navbar-brand navtitle" asp-area="" asp-controller="Home" asp-action="Index">TimeManagement</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light navtext" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light navtext" asp-controller="Semesters" asp-action="Index">Semesters</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light navtext" asp-controller="Modules" asp-action="Index">Modules</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light navtext" asp-controller="ModuleHours" asp-action="Index">StudyTime</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light navtext" asp-controller="ModuleHours" asp-action="Graph">Graph</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light navtext" asp-controller="ModuleHours" asp-action="Calendar">Calendar</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2023 - TimeManagement - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>