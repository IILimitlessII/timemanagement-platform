@model TimemanagementPlatform.Web.Models.Module

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>Module</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ModuleId" />
            <div class="form-group">
                <label asp-for="Code" class="control-label">Module Code</label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label">Module Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Credits" class="control-label"></label>
                <input asp-for="Credits" class="form-control" />
                <span asp-validation-for="Credits" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ClassHrsWeekly" class="control-label">Weekly Hours in Class</label>
                <input asp-for="ClassHrsWeekly" class="form-control" />
                <span asp-validation-for="ClassHrsWeekly" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HrsSelfStudy" class="control-label" hidden></label>
                <input asp-for="HrsSelfStudy" class="form-control" hidden/>
                <span asp-validation-for="HrsSelfStudy" class="text-danger" hidden></span>
            </div>
            <div class="form-group">
                <label asp-for="HrsSelfStudyLeft" class="control-label" hidden></label>
                <input asp-for="HrsSelfStudyLeft" class="form-control" hidden/>
                <span asp-validation-for="HrsSelfStudyLeft" class="text-danger" hidden></span>
            </div>
            <div class="form-group">
                <label asp-for="SelectedColourName" class="control-label">Currently Saved Colour</label>
                <input asp-for="SelectedColourName" class="form-control" readonly />
                <span asp-validation-for="SelectedColourName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SelectedColourHex" class="control-label">Changed Value of Colour</label>
                <select asp-for="SelectedColourHex" class="form-control" asp-items="ViewBag.Colour"></select>
                <span asp-validation-for="SelectedColourHex" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserId" class="control-label" hidden></label>
                <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId" hidden></select>
                <span asp-validation-for="UserId" class="text-danger" hidden></span>
            </div>
            <div class="form-group">
                <label asp-for="SemesterId" class="control-label"></label>
                <select asp-for="SemesterId" class="form-control" asp-items="ViewBag.SemesterIdList"></select>
                <span asp-validation-for="SemesterId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
